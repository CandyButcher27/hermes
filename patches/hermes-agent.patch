+  } catch (err) {
+    drafts.delete(code);
+    return res.status(500).json({ error: err.message });
+  }
+  writeJsonLine({ event: 'draft_created', code, chatId });
+  res.json({ success: true, code, chatId, name, expiresInMinutes: 30 });
+});
