+  if (APPROVE_RE.test(String(req.body?.message || req.body?.caption || req.body?.question || ''))) {
+    return res.status(403).json({ error: 'refusing to send a draft approval command' });
+  }
+  if (HOME_GROUP && target && target !== HOME_GROUP) {
+    writeJsonLine({ event: 'send_blocked', chatId: target, path: req.path });
+    return res.status(403).json({ error: 'Sending outside the home group needs an approved draft: POST /draft' });
+  }
+  next();
+});
