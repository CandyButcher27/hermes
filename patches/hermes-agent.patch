+  if (APPROVE_RE.test(String(text))) return res.status(400).json({ error: 'text looks like an approval command' });
+  const query = String(chat).toLowerCase().replace(/^\+/, '');
+  const matches = [];
+  for (const jid of SEND_CHATS) {
+    const name = await chatName(jid);
+    if (jid.toLowerCase() === query || jid.split('@')[0] === query || name.toLowerCase().includes(query)) matches.push({ chatId: jid, name });
+  }
+  if (matches.length !== 1) {
+    return res.status(matches.length ? 409 : 404).json({
+      error: matches.length ? 'more than one allowed chat matches' : 'no chat in WHATSAPP_SEND_CHATS matches',
+      matches,
+    });
+  }
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+  let code;
+  do { code = Array.from(randomBytes(4), (b) => alphabet[b % alphabet.length]).join(''); } while (drafts.has(code));
+  const { chatId, name } = matches[0];
+  drafts.set(code, { chatId, name, text: String(text), expires: Date.now() + DRAFT_TTL_MS });
